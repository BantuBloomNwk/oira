# RunPod Serverless worker for Oira STT (faster-whisper). Build, push, point a Serverless
# endpoint at it. Uses a CUDA base so large-v3 runs on GPU. The base is pinned by digest.
FROM runpod/base:0.6.2-cuda12.2.0@sha256:3b0915a6d8b3e5eb6b8e059147d43d4cd93746d49045c6f2f228e12845953369

RUN pip install --no-cache-dir faster-whisper==1.0.3 runpod==1.7.0

# Runs as an unprivileged user. The model cache lives in /models so that user can read the
# copy baked in below instead of looking for it under /root.
RUN useradd --create-home --uid 1001 worker && mkdir -p /models && chown worker:worker /models
ENV HF_HOME=/models
USER worker

# Pre-bake the model into the image so cold starts don't re-download it (optional but faster).
# Comment out to keep the image small and download on first run instead.
ENV WHISPER_MODEL=large-v3 WHISPER_DEVICE=cuda WHISPER_COMPUTE=float16
RUN python -c "from faster_whisper import WhisperModel; WhisperModel('large-v3')" || true

COPY --chown=worker:worker runpod_handler.py /handler.py
CMD ["python", "-u", "/handler.py"]
